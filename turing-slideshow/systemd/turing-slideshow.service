# =====================================================================
# systemd unit file for turing-slideshow.
# =====================================================================
# Installed by install.sh to /etc/systemd/system/turing-slideshow.service
# so the slideshow starts automatically at boot.
#
# Edit User= and Group= below to match your user, or pass them when you run
# install.sh:
#
#   sudo SLIDESHOW_USER=alice ./install.sh
#
# =====================================================================

[Unit]
Description=Turing Smart Screen image slideshow
# Start after the network and basic targets are up. The screen is USB-CDC
# so it appears as soon as USB is ready; we don't need network-online.
After=multi-user.target
Wants=multi-user.target

[Service]
Type=simple

# IMPORTANT: change these to the user that should run the slideshow.
# That user MUST be a member of the `dialout` group so it can open the
# serial port of the smart screen. Run:
#   sudo usermod -a -G dialout $USER
# (then log out and back in for the group change to take effect).
User=__SLIDESHOW_USER__
Group=__SLIDESHOW_GROUP__

# Assume the parent repo is cloned to /opt/turing-smart-screen-python.
# If you cloned elsewhere, edit WorkingDirectory and ExecStart accordingly.
WorkingDirectory=/opt/turing-smart-screen-python

# Use the venv interpreter if present (recommended), otherwise the system python3.
ExecStart=/opt/turing-smart-screen-python/venv/bin/python3 /opt/turing-smart-screen-python/turing-slideshow/slideshow.py

# Restart policy: if the slideshow crashes, restart it (USB glitch, image
# parse error, etc). systemd will throttle with the default backoff.
Restart=on-failure
RestartSec=5s

# Send a clean SIGTERM (which slideshow.py handles) so the screen is
# cleared before being powered off.
KillSignal=SIGTERM
TimeoutStopSec=15

# Run from a clean environment; logging goes to the journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=turing-slideshow

# Nice=10  -> slightly lower priority so background slideshow never
# fights foreground work on resource-constrained systems like a Pi.
Nice=10

[Install]
WantedBy=multi-user.target
