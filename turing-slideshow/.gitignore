# Local config overrides (don't push your local path / brightness tweaks)
config.local.yaml

# But DO keep example/sample configs
!examples/

# Local log output (if any)
*.log

# Don't commit actual images by default (the .gitkeep stays)
images/*
!images/.gitkeep

# Built artifacts
dist/
build/
